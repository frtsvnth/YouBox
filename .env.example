# ============================================================
# YouBox — конфигурация для production (Docker Compose)
# ============================================================
# Скопируйте в .env и заполните:
#   cp .env.example .env && nano .env

# ═══════════════════════════════════════════════════════════
# ⚠️  .env НИКОГДА не должен попасть в git!
# ═══════════════════════════════════════════════════════════
# Этот файл добавлен в .gitignore.
# Перед коммитом проверьте: git status | grep .env

# === Обязательные ===

# SHA-256 хеш от PIN-кода (рекомендуется)
# Сгенерировать: echo -n "твойпин" | shasum -a 256 | cut -d' ' -f1
APP_PIN_HASH=8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92

# AUTH_PIN=123456  # Альтернатива — plaintext PIN (НЕ РЕКОМЕНДУЕТСЯ)

# === Traefik (reverse proxy) ===
YOUBOX_HOST=youbox.example.com                # Домен, по которому доступен YouBox
TRAEFIK_NETWORK=root_default                  # Внешняя сеть Traefik (docker network ls)
TRAEFIK_ENTRYPOINTS=websecure                 # Entrypoint Traefik (обычно websecure)
TRAEFIK_CERTRESOLVER=mytlschallenge           # CertResolver для Let's Encrypt
APP_BASE_URL=https://${YOUBOX_HOST}           # Базовый URL приложения (используется для cookies, redirects)

# === Директория данных (внутри контейнера) ===
DATA_DIR=/data

# === Сессии ===
SESSION_TTL=86400              # Время жизни сессии (секунды, 24ч)

# === Файлы ===
FILE_TTL=9200                  # Время жизни готового файла (секунды, 2ч)

# === Безопасность ===
LOGIN_MAX_ATTEMPTS=5           # Максимум неудачных попыток входа
LOGIN_LOCKOUT_DURATION=300     # Блокировка после превышения (секунды, 5мин)

# === yt-dlp ===
# Путь к cookies.txt на хосте (см. docs/COOKIES.md)
# Рекомендуется: /opt/youbox-secrets/youtube.cookies.txt
YT_COOKIES_FILE=/opt/youbox-secrets/youtube.cookies.txt
PLAYLIST_MAX_ITEMS=10          # Максимум элементов плейлиста

# === Cookie Source Management ===
# ENABLE_BROWSER_COOKIE_SOURCE=true    # Включить поддержку браузерной сессии (sidecar)
# DEFAULT_COOKIE_SOURCE=uploaded_file  # uploaded_file | browser_session
# BROWSER_COOKIE_SERVICE_URL=http://youbox-browser:3808  # URL sidecar-сервиса для экспорта cookies
# BROWSER_COOKIE_EXPORT_PATH=/data/cookies/browser-exported.txt  # Куда сохранять экспортированные cookies

# Ротация источников cookies: кулдаун источника после ошибки авторизации (минуты)
# COOKIE_SOURCE_COOLDOWN_MINUTES=45

# === PO Token provider (bgutil) — опционально ===
# Помогает обойти "Sign in to confirm you're not a bot".
# Запустите сайдкар: docker compose --profile pot up -d bgutil-pot
# Затем укажите URL (внутри docker-сети):
# POT_PROVIDER_URL=http://bgutil-pot:4416

# === Авто-обновление cookies через sidecar (Playwright autologin) — опционально ===
# Требует запущенного youbox-browser (--profile browser) и заданных аккаунтов ниже.
# ENABLE_COOKIE_AUTO_REFRESH=true
# COOKIE_REFRESH_INTERVAL_MINUTES=360   # Как часто обновлять cookies (минуты)

# ⚠️  Google-аккаунты для автологина.
# Задаются ТОЛЬКО в вашем локальном .env на VPS. НИКОГДА не коммитьте реальные значения!
# Нумерация подряд: GOOGLE_ACCOUNT_1_*, GOOGLE_ACCOUNT_2_*, ...
# GOOGLE_ACCOUNT_1_EMAIL=your-account-1@example.com
# GOOGLE_ACCOUNT_1_PASSWORD=your-password-1
# GOOGLE_ACCOUNT_2_EMAIL=your-account-2@example.com
# GOOGLE_ACCOUNT_2_PASSWORD=your-password-2

# === Сервер ===
PORT=3007                      # Порт внутри контейнера (не менять)

# === Cookies ===
# COOKIE_SECURE=true           # true, если за HTTPS (Traefik), false для HTTP

# === Логирование ===
LOG_LEVEL=info                 # debug | info | warn | error
